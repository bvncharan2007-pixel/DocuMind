# ==============================================================================
# DocuMind — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# Every variable listed here is read by the application. Unknown names are
# silently ignored.
# ==============================================================================


# ── REQUIRED ──────────────────────────────────────────────────────────────────

# Google Gemini API key — required for PDF embedding and Q&A generation.
# Obtain from: https://aistudio.google.com/app/apikey
# WARNING: Document text is sent to Google's servers during processing.
# Do not upload confidential documents without reviewing Google's data-handling
# terms for the tier you are using.
GOOGLE_API_KEY=your_google_api_key_here

# Session secret — used for session integrity.
# Minimum 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DOCUMIND_SESSION_SECRET=change-this-in-production-use-a-strong-secret-key-32chars


# ── STORAGE PATHS ─────────────────────────────────────────────────────────────
# These paths must survive server restarts. Point them to a persistent volume
# in any hosted environment.

# SQLite database file path
DOCUMIND_DB_PATH=data/documind.db

# Directory where uploaded PDF files are stored (UUID filenames)
DOCUMIND_UPLOAD_DIR=data/uploads

# Directory where FAISS vector indexes are stored (per-conversation)
DOCUMIND_INDEX_DIR=data/indexes


# ── GEMINI MODELS ─────────────────────────────────────────────────────────────
# text-embedding-004 was retired January 14 2026 — do not use it.

# Embedding model (default: gemini-embedding-001, outputs 3072 dims by default)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Embedding vector dimensions (truncated from 3072 via MRL technique)
GEMINI_EMBEDDING_DIMENSIONS=768

# Generation model (free tier: 15 RPM / 1500 req/day)
GEMINI_GENERATION_MODEL=gemini-1.5-flash

# Maximum retry attempts on transient Gemini errors
GEMINI_MAX_RETRIES=3

# Base backoff seconds between retries (exponential: 2, 4, 8…)
GEMINI_RETRY_BACKOFF=2.0


# ── UPLOAD LIMITS ─────────────────────────────────────────────────────────────

# Maximum size per uploaded file in megabytes
MAX_FILE_SIZE_MB=50

# Maximum number of files accepted in a single upload request
MAX_FILES_PER_REQUEST=10

# Maximum total documents per conversation
MAX_DOCS_PER_CONV=20


# ── CHUNKING AND RETRIEVAL ────────────────────────────────────────────────────

# Characters per text chunk (affects embedding quality and API cost)
CHUNK_SIZE=800

# Character overlap between consecutive chunks (helps preserve context at boundaries)
CHUNK_OVERLAP=150

# Number of top-k chunks retrieved and passed to Gemini for each question
MAX_RETRIEVAL_CHUNKS=6

# Minimum similarity score threshold (L2 distance — lower = closer; 0.0 = no threshold)
MIN_SIMILARITY_SCORE=0.0


# ── SESSION AND COOKIES ───────────────────────────────────────────────────────

# Session lifetime in seconds (default: 86400 = 24 hours)
DOCUMIND_SESSION_LIFETIME=86400

# Set to 'true' in HTTPS production deployments to enable Secure cookie flag
# MUST be true when served over HTTPS — otherwise browsers will reject cookies
DOCUMIND_COOKIE_SECURE=false

# Cookie SameSite attribute ('lax', 'strict', or 'none')
DOCUMIND_COOKIE_SAMESITE=lax


# ── RATE LIMITING ─────────────────────────────────────────────────────────────
# Rate limiting is in-memory only — counters reset on server restart.

# Failed login attempts before a 429 Too Many Requests is returned
MAX_FAILED_LOGINS=5

# Window in seconds over which failed attempts are counted
RATE_LIMIT_WINDOW=300
